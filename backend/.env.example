DATABASE_URL=postgresql://sgas_user:sgas_pass@localhost:5432/sgas_db
JWT_SECRET=replace_with_output_of__openssl_rand_hex_64
PORT=5001

# ── System Admin ──────────────────────────────────────────────────────────────
# The ONLY admin account. Seeded automatically on server startup (idempotent).
# Public /register is locked to 'student' — this is the sole path to admin access.
# Change these before going to production.
SYSADMIN_NAME=System Administrator
SYSADMIN_EMAIL=sysadmin@yourdomain.com
SYSADMIN_PASSWORD=change_me_before_deploy
